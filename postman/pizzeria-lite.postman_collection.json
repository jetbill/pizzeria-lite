{
  "info": {
    "name": "Pizzeria Lite",
    "description": "Coleccion de ejemplo para probar manualmente los endpoints del monolito de gestion de pedidos de la pizzeria.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "List all products",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/products"
          }
        },
        {
          "name": "Get product by id",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/products/1"
          }
        },
        {
          "name": "Search products by name (SQL injection demo)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/products/search?name=pizza"
          }
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pepperoni Lovers Pizza\",\n  \"description\": \"Double pepperoni, extra cheese\",\n  \"category\": \"PIZZA\",\n  \"price\": 12.99,\n  \"available\": true\n}"
            }
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/products/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Margherita Pizza\",\n  \"description\": \"Tomato sauce, mozzarella and fresh basil\",\n  \"category\": \"PIZZA\",\n  \"price\": 9.49,\n  \"available\": true\n}"
            }
          }
        },
        {
          "name": "Toggle product availability",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/products/1/availability?available=false"
          }
        },
        {
          "name": "Delete product",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/products/9"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List all orders",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/orders"
          }
        },
        {
          "name": "Get order by id",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/orders/1"
          }
        },
        {
          "name": "Search orders by customer name (SQL injection demo)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/orders/search?customerName=Juan"
          }
        },
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Ana Torres\",\n  \"customerPhone\": \"+51999888777\",\n  \"customerAddress\": \"Av. Central 100, Lima\",\n  \"couponCode\": \"PIZZA10\",\n  \"items\": [\n    { \"productId\": 2, \"quantity\": 2 },\n    { \"productId\": 5, \"quantity\": 3 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Update order status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/orders/3/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PREPARATION\"\n}"
            }
          }
        },
        {
          "name": "Delete order",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/orders/1"
          }
        }
      ]
    },
    {
      "name": "Actuator (exposed without restrictions)",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/actuator/health"
          }
        },
        {
          "name": "Env (leaks datasource credentials and API key)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/actuator/env"
          }
        },
        {
          "name": "Beans",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/actuator/beans"
          }
        }
      ]
    }
  ]
}
